# Required. Docker Compose rejects startup when this value is unset.
NEO4J_PASSWORD=replace-with-a-strong-password

# Neo4j authentication user.
NEO4J_USER=neo4j

# Host interface and port exposed for Bolt. Keep the loopback default unless
# access is protected by a private network or firewall.
NEO4J_BIND=127.0.0.1
NEO4J_BOLT_PORT=7687

# Neo4j memory limits.
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M

# Migration target. NEO4J_URI, NEO4J_USER, and NEO4J_PASSWORD are required by
# `bun run migrate`.
NEO4J_URI=bolt://127.0.0.1:7687

# Container stopped and mounted by `bun run backup`.
NEO4J_CONTAINER=anamnesis-neo4j-1
