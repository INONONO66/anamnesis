{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "lease_epoch": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "state": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "provider_unavailable",
            "provider_rejected",
            "provider_mismatch",
            "output_too_large",
            "input_too_large",
            "policy_denied",
            "cancelled",
            "expired",
            "worker_lost",
            "premises_changed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "disposition": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "retain",
            "suppress",
            "correct",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "canonical_body": {
              "type": "string",
              "maxLength": 65536
            },
            "body_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "spans": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 8192
                  }
                },
                "required": [
                  "start",
                  "end",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "language": {
              "type": "string",
              "maxLength": 64
            },
            "modality": {
              "type": "string",
              "enum": [
                "text",
                "code",
                "mixed",
                "unknown"
              ]
            }
          },
          "required": [
            "canonical_body",
            "body_digest",
            "spans",
            "language",
            "modality"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "spans": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "detail": {
      "type": "string",
      "enum": [
        "model",
        "incarnation",
        "envelope",
        "json",
        "normalize",
        "span",
        "judge_shape",
        "digest"
      ]
    }
  },
  "required": [
    "task_id",
    "expected_version",
    "id",
    "lease_epoch",
    "state",
    "reason",
    "disposition",
    "output",
    "spans"
  ],
  "additionalProperties": false
}
