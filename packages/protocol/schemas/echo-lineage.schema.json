{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "lineage_mode": {
      "type": "string",
      "enum": [
        "direct",
        "receipts"
      ]
    },
    "parent_recall_ids": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    },
    "context_digests": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "root_episode_ids": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    },
    "echo_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "complete": {
      "type": "boolean"
    }
  },
  "required": [
    "episode_id",
    "lineage_mode",
    "parent_recall_ids",
    "context_digests",
    "root_episode_ids",
    "echo_depth",
    "complete"
  ],
  "additionalProperties": false
}
