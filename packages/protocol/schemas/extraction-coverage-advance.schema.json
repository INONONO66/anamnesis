{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "partition": {
      "type": "string",
      "enum": [
        "episodes",
        "active_extraction"
      ]
    },
    "expected_covered_ingest_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "covered_ingest_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "generation_id",
    "partition",
    "expected_covered_ingest_seq",
    "covered_ingest_seq"
  ],
  "additionalProperties": false
}
