{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "pipeline_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "source_head_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "claim_context": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "body_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claims": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 8192
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 8192
                  }
                },
                "required": [
                  "start",
                  "end",
                  "text"
                ],
                "additionalProperties": false
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "entities": {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "mention": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "normalized_name": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "entity_kind": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "mention",
                    "normalized_name",
                    "entity_kind"
                  ],
                  "additionalProperties": false
                }
              },
              "time": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "precision": {
                    "type": "string",
                    "enum": [
                      "second",
                      "minute",
                      "day",
                      "month",
                      "year"
                    ]
                  }
                },
                "required": [
                  "value",
                  "precision"
                ],
                "additionalProperties": false
              },
              "sub_kind": {
                "type": "string",
                "enum": [
                  "fact",
                  "state",
                  "event",
                  "preference",
                  "procedure",
                  "decision",
                  "summary"
                ]
              },
              "speech_act": {
                "type": "string",
                "enum": [
                  "asserted",
                  "reported",
                  "hedged",
                  "intended",
                  "hypothetical"
                ]
              }
            },
            "required": [
              "text",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "task_id",
        "attempt_id",
        "body_digest",
        "claims"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "task_id",
    "attempt_id",
    "pipeline_id",
    "source_head_revision",
    "policy_revision",
    "claim_context"
  ],
  "additionalProperties": false
}
