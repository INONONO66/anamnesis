{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "generation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "source_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_ingest_seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "claim",
        "judge",
        "judge_claims"
      ]
    },
    "model": {
      "type": "string",
      "maxLength": 256
    },
    "model_incarnation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pipeline": {
      "type": "string",
      "const": "claim-judge-audit-v1"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "succeeded",
        "failed",
        "expired",
        "cancelled",
        "worker_lost"
      ]
    },
    "lease": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "worker_id": {
              "type": "string",
              "maxLength": 256
            },
            "epoch": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
            },
            "writer_epoch": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "expires_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "worker_id",
            "epoch",
            "writer_epoch",
            "expires_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_context": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "authority": {
              "type": "string",
              "const": "installation"
            }
          },
          "required": [
            "revision",
            "authority"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "lost_leases": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "generation_id",
    "source_id",
    "source_revision",
    "body_digest",
    "source_ingest_seq",
    "attempt_id",
    "kind",
    "model",
    "model_incarnation",
    "state",
    "lease",
    "policy_context",
    "version",
    "attempts",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
