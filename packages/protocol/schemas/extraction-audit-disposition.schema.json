{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "judge_attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "claim_attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "claim_body_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "disposition": {
      "type": "string",
      "enum": [
        "retain",
        "suppress",
        "correct",
        "unknown"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "judge_attempt_id",
    "claim_attempt_id",
    "claim_body_digest",
    "claim_index",
    "disposition",
    "evidence"
  ],
  "additionalProperties": false
}
