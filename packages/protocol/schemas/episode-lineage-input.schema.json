{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "origin_role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool",
        "document",
        "operator"
      ]
    },
    "lineage_mode": {
      "type": "string",
      "enum": [
        "direct",
        "receipts"
      ]
    },
    "parent_recall_ids": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    }
  },
  "required": [
    "origin_role",
    "lineage_mode",
    "parent_recall_ids"
  ],
  "additionalProperties": false
}
