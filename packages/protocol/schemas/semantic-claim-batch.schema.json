{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claims": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "content_language": {
            "type": "string",
            "maxLength": 35,
            "pattern": "^[a-z]{2,8}(?:-[a-z0-9]{1,8})*$"
          },
          "sub_kind": {
            "type": "string",
            "enum": [
              "fact",
              "state",
              "event",
              "preference",
              "procedure",
              "decision",
              "summary"
            ]
          },
          "modality": {
            "type": "string",
            "enum": [
              "asserted",
              "reported",
              "hedged",
              "intended",
              "hypothetical"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "time": {
            "type": "object",
            "properties": {
              "time_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "time_utc": {
                "type": "integer",
                "minimum": -8640000000000000,
                "maximum": 8640000000000000
              },
              "time_precision": {
                "type": "string",
                "enum": [
                  "instant",
                  "day",
                  "month",
                  "year",
                  "inherited"
                ]
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "explicit",
                  "relative",
                  "inherited"
                ]
              },
              "anchor_time_utc": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -8640000000000000,
                    "maximum": 8640000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "time_value",
              "time_utc",
              "time_precision",
              "resolution",
              "anchor_time_utc"
            ],
            "additionalProperties": false
          },
          "entities": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mention": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "entity_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "mention",
                "entity_id"
              ],
              "additionalProperties": false
            }
          },
          "subject_keys": {
            "anyOf": [
              {
                "minItems": 1,
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "predicate_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "scope": {
            "type": "object",
            "properties": {
              "object_keys": {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                }
              },
              "location_keys": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                }
              },
              "quantities": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^(?:0|-?(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              },
              "condition": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "attribution_speaker_keys": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "required": [
              "object_keys",
              "location_keys",
              "quantities",
              "condition",
              "attribution_speaker_keys"
            ],
            "additionalProperties": false
          },
          "scope_complete": {
            "type": "boolean"
          },
          "evidence": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "source_locus"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "span": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "no_single_locus"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "content",
          "content_language",
          "sub_kind",
          "modality",
          "confidence",
          "time",
          "entities",
          "subject_keys",
          "predicate_text",
          "scope",
          "scope_complete",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "claims"
  ],
  "additionalProperties": false
}
