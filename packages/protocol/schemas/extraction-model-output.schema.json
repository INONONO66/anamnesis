{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "const": "claim"
        },
        "claims": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 8192
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 8192
                  }
                },
                "required": [
                  "start",
                  "end",
                  "text"
                ],
                "additionalProperties": false
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "entities": {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "mention": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "normalized_name": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "entity_kind": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "mention",
                    "normalized_name",
                    "entity_kind"
                  ],
                  "additionalProperties": false
                }
              },
              "time": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "precision": {
                    "type": "string",
                    "enum": [
                      "second",
                      "minute",
                      "day",
                      "month",
                      "year"
                    ]
                  }
                },
                "required": [
                  "value",
                  "precision"
                ],
                "additionalProperties": false
              },
              "sub_kind": {
                "type": "string",
                "enum": [
                  "fact",
                  "state",
                  "event",
                  "preference",
                  "procedure",
                  "decision",
                  "summary"
                ]
              },
              "speech_act": {
                "type": "string",
                "enum": [
                  "asserted",
                  "reported",
                  "hedged",
                  "intended",
                  "hypothetical"
                ]
              }
            },
            "required": [
              "text",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "modality": {
          "type": "string",
          "enum": [
            "text",
            "code",
            "mixed",
            "unknown"
          ]
        }
      },
      "required": [
        "task",
        "claims",
        "language",
        "modality"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "const": "judge"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "retain",
            "suppress",
            "correct",
            "unknown"
          ]
        },
        "spans": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "modality": {
          "type": "string",
          "enum": [
            "text",
            "code",
            "mixed",
            "unknown"
          ]
        }
      },
      "required": [
        "task",
        "disposition",
        "spans",
        "language",
        "modality"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "const": "judge_claims"
        },
        "claim_body_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decisions": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "retain",
                  "suppress",
                  "correct",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 8192
                  }
                },
                "required": [
                  "start",
                  "end",
                  "text"
                ],
                "additionalProperties": false
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "claim_index",
              "disposition",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "modality": {
          "type": "string",
          "enum": [
            "text",
            "code",
            "mixed",
            "unknown"
          ]
        }
      },
      "required": [
        "task",
        "claim_body_digest",
        "decisions",
        "language",
        "modality"
      ],
      "additionalProperties": false
    }
  ]
}
