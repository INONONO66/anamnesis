{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "const": "claim"
        },
        "claims": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 8192
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 8192
                  }
                },
                "required": [
                  "start",
                  "end",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "text",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "modality": {
          "type": "string",
          "enum": [
            "text",
            "code",
            "mixed",
            "unknown"
          ]
        }
      },
      "required": [
        "task",
        "claims",
        "language",
        "modality"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "const": "judge"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "retain",
            "suppress",
            "correct",
            "unknown"
          ]
        },
        "spans": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "modality": {
          "type": "string",
          "enum": [
            "text",
            "code",
            "mixed",
            "unknown"
          ]
        }
      },
      "required": [
        "task",
        "disposition",
        "spans",
        "language",
        "modality"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "const": "judge_claims"
        },
        "claim_body_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decisions": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "retain",
                  "suppress",
                  "correct",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 8192
                  }
                },
                "required": [
                  "start",
                  "end",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "claim_index",
              "disposition",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "modality": {
          "type": "string",
          "enum": [
            "text",
            "code",
            "mixed",
            "unknown"
          ]
        }
      },
      "required": [
        "task",
        "claim_body_digest",
        "decisions",
        "language",
        "modality"
      ],
      "additionalProperties": false
    }
  ]
}
