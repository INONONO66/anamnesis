# /etc/anamnesis/anamnesis.env  (mode 0600, owner anamnesis). Copy and fill; never commit a filled copy.
ANAMNESIS_RUNTIME_ROOT=/var/lib/anamnesis/runtime
ANAMNESIS_OBJECTS_ROOT=/var/lib/anamnesis/objects
ANAMNESIS_NEO4J_URI=bolt://127.0.0.1:7687
ANAMNESIS_NEO4J_USER=neo4j
ANAMNESIS_NEO4J_PASSWORD=__from_/opt/anamnesis/.env__
ANAMNESIS_NEO4J_DATABASE=neo4j
ANAMNESIS_NEO4J_CONTAINER=anamnesis-neo4j-1
# TCP listener on the tailnet address of this guest (UDS stays on).
ANAMNESIS_LISTEN=100.64.0.0:4400
ANAMNESIS_LISTEN_TOKEN_FILE=/etc/anamnesis/listen-token
# LLM: token-hub on inonono, reached through anamnesis-tunnel.service (local 19080 -> inonono:19080).
ANAMNESIS_LLM_BASE_URL=http://127.0.0.1:19080
ANAMNESIS_LLM_MODEL=claude-haiku-4-5-20251001
ANAMNESIS_LLM_DIALECT=anthropic_messages
ANAMNESIS_LLM_API_KEY_FILE=/etc/anamnesis/token-hub-haiku.json
# Pacing: blend into shared hub traffic (~0.25 req/s avg, in-flight <= 2, jittered).
ANAMNESIS_EXTRACTION_MAX_IN_FLIGHT=2
ANAMNESIS_LLM_MIN_INTERVAL_MS=4000
ANAMNESIS_LLM_JITTER_FRACTION=0.5
# Embeddings: llama-server on inonono through the same tunnel (local 18081 -> inonono:18081).
ANAMNESIS_EMBEDDING_BASE_URL=http://127.0.0.1:18081
ANAMNESIS_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
ANAMNESIS_EMBEDDING_DIMENSIONS=1024
