# ~/.config/anamnesis/ingest.env (mode 0600). Client-side connection to the PVE daemon.
ANAMNESIS_REPO=/home/inonono/Develop/anamnesis
ANAMNESIS_RUNTIME_ROOT=/home/inonono/.local/state/anamnesis-ingest/client-root
ANAMNESIS_RPC_TCP=100.64.0.0:4400
ANAMNESIS_RPC_TCP_TOKEN_FILE=/home/inonono/.config/anamnesis/listen-token
ANAMNESIS_RUNTIME_TOKEN_FILE=/home/inonono/.config/anamnesis/pve-runtime-token
ANAMNESIS_INGEST_STATE=/home/inonono/.local/state/anamnesis-ingest
VAULT_ROOT=/mnt/data/hub/vault-files
